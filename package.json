{
  "name": "witness",
  "version": "0.2.0",
  "description": "Witness \u2014 the DVC agent flight recorder: a local-first, tamper-evident record of what your AI agents exist, can touch, and did.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dark-vector-cognition/witness.git"
  },
  "homepage": "https://darkvectorcognition.ai/flight-check/",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "dev": "npm run ingest && node scripts/dev.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run ingest && npm run verify:ledger && npm run build && node --test tests/*.test.mjs",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "export:evidence": "node scripts/export-evidence.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
