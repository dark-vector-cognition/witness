{
  "name": "@darkvectorcognition.ai/witness",
  "version": "0.3.0",
  "description": "Witness — a transparent MCP proxy that writes a tamper-evident, hash-chained record of what your AI agents actually did at the tool boundary. Local-first, zero dependencies.",
  "license": "Apache-2.0",
  "author": "Dark Vector Cognition LLC <hello@darkvectorcognition.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dark-vector-cognition/witness.git"
  },
  "homepage": "https://github.com/dark-vector-cognition/witness#readme",
  "bugs": "https://github.com/dark-vector-cognition/witness/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "audit-log",
    "tamper-evident",
    "hash-chain",
    "flight-recorder",
    "observability",
    "proxy"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "witness": "bin/witness.mjs"
  },
  "exports": {
    ".": "./lib/record.mjs",
    "./record": "./lib/record.mjs",
    "./proxy": "./lib/proxy.mjs",
    "./http-proxy": "./lib/http-proxy.mjs",
    "./session-log": "./lib/session-log.mjs",
    "./analyze": "./lib/analyze.mjs",
    "./wrap": "./lib/wrap.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify": "node bin/witness.mjs verify",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  }
}
